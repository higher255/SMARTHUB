{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "env -u NPM_CONFIG_CACHE_DIR -u npm_config_cache_dir -u npm_config_cache-dir npm install",
  "buildCommand": "env -u NPM_CONFIG_CACHE_DIR -u npm_config_cache_dir -u npm_config_cache-dir npm run build",
  "crons": [
    {
      "path": "/api/cron/missing-checkouts",
      "schedule": "0 15 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
